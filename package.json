{
  "name": "uniswap-v3-subgraph",
  "version": "1.0.0",
  "description": "Subgraph for indexing Uniswap V3 on Ethereum mainnet using The Graph Protocol",
  "scripts": {
    "codegen": "graph codegen",
    "build": "graph build",
    "deploy": "graph deploy --studio uniswap-v3-subgraph",
    "create-local": "graph create --node http://localhost:8020/ uniswap-v3-subgraph",
    "remove-local": "graph remove --node http://localhost:8020/ uniswap-v3-subgraph",
    "deploy-local": "graph deploy --node http://localhost:8020/ --ipfs http://localhost:5001 uniswap-v3-subgraph",
    "test": "graph test"
  },
  "dependencies": {
    "@graphprotocol/graph-cli": "0.51.2",
    "@graphprotocol/graph-ts": "0.31.0"
  },
  "devDependencies": {
    "matchstick-as": "0.5.2"
  }
}
